#!/bin/sh
# claude-box -- the workstation container, on whatever directory you are in.
#
# Generated by `make install` from claude-box.in, with the path of the Makefile
# it was generated from baked in, so there is still exactly one place that knows
# how to start the container.
#
#   claude-box                                Claude Code on the current directory
#   claude-box -p 'what does this build?'     its flags, passed through
#   claude-box --dangerously-skip-permissions
#   claude-box codex -m gpt-5                 a target first, then the agent's flags
#   claude-box shell                          bash instead
#   claude-box lean                           Claude Code with the Lean tools on
#   claude-box WORK=/home/you/src/other       a make variable, exactly as make takes it
#   claude-box help                           every target
#
# An alias cannot do this, which is the whole reason this file exists: make
# reads a bare `-m gpt-5` as a target of its own, so `claude-box -m gpt-5`
# starts a session *without* the flag and only then fails on `No rule to make
# target 'gpt-5'`. A shell function with ARGS="$*" fixes that and gives up the
# targets -- `claude-box shell` becomes a Claude Code session with two stray
# arguments.
#
# So: leading words make would understand -- a target, or a VAR=value
# assignment -- are passed to make as they are, and from the first word it would
# not understand, everything is the agent's and goes to ARGS. `-p 'two words'`
# survives as one argument, and a `$` in a prompt reaches the agent rather than
# make's expander.

set -u

MAKEFILE='@MAKEFILE@'

# Every target in that Makefile's .PHONY, surrounded by spaces so the case
# below matches whole words only.
TARGETS=' run image home update check-update build slim minimal rebuild shell codex lean lean-image lean-update bench versions size install push pull prune clean help '

# Wrap a word in single quotes for re-evaluation, with any single quote inside
# broken out: don't -> 'don'\''t'.
shquote() {
	printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"
}

lead=''
while [ $# -gt 0 ]; do
	case "$1" in
		-*) break ;;
		*=*) ;;
		*) case "$TARGETS" in
			*" $1 "*) ;;
			*) break ;;
		esac ;;
	esac
	lead="$lead $(shquote "$1")"
	shift
done

args=''
for a in "$@"; do
	args="$args $(shquote "$a")"
done

# make expands the value of a command-line variable when the recipe uses it, so
# a literal $ in a prompt has to survive that pass as well.
args=$(printf '%s' "$args" | sed 's/\$/$$/g')

if [ -n "$args" ]; then
	eval "set -- $lead" 'ARGS="${args# }"'
else
	eval "set -- $lead"
fi

exec make -f "$MAKEFILE" "$@"
